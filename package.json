{
  "name": "dsh-studio",
  "version": "0.1.0",
  "private": true,
  "description": "推广创作台：粘贴商品原文，生成合规的小红书 / 抖音 / 快手等平台推广文案与多尺寸卡片图",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gzyxds/dsh-studio-plugin.git"
  },
  "homepage": "https://github.com/gzyxds/dsh-studio-plugin#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "INSTALL.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "esbuild": "^0.25.12",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "license": "MIT"
}
